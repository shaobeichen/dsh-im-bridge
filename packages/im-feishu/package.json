{
  "name": "dsh-im-feishu",
  "version": "1.0.4",
  "description": "飞书渠道适配器（dsh-im 插件家族，experimental）：WebSocket 长连接免公网 + 审批卡片按钮。需要真实飞书自建应用凭据，未经 CI 实测。",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-im-feishu-qr": "bin/feishu-qr.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "client",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build:client": "node client/build.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.9"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "dsh-im": "^1.0.4"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaobeichen/dsh-im-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/shaobeichen/dsh-im-bridge/issues"
  },
  "homepage": "https://github.com/shaobeichen/dsh-im-bridge",
  "author": "shaobeichen",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "feishu",
    "lark",
    "im-bridge"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
